# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
build/
dist/

# environment and secrets
.env
.env.*
!.env.example
*.pem
*.tfvars
!deploy/aws/terraform/example.tfvars
.terraform/
*.tfstate*

# data and trained artifacts are NEVER committed (proprietary dataset; CI uses synthetic)
data/*
!data/README.md
*.db
*.sqlite*
*.csv
*.parquet
*.npz
*.npy
*.joblib
*.pkl
*.pt
*.txt.gz
models/*
!models/README.md
mlruns/
mlartifacts/
reports/predictions/
reports/mlflow.db
reports/runs.jsonl
# the study's published evidence IS committed
!reports/results.csv
!reports/comparison_stats.csv
!reports/pairwise_mape.csv
!reports/error_profile.csv
!reports/price_bands.csv
!reports/segments.csv
# the 38,758-row pilot study's evidence stays committed alongside the corpus-scale run
!reports/pilot/
!reports/pilot/*.csv
logs/

# figures are regenerated; committed ones live in docs/ only
reports/figures/

# documents build locally; the published paper PDF ships with the Pages site
*.pdf
*.docx
!docs/*.pdf
# archived editions of the paper stay as committed reference
!paper/archive/**/*.pdf
!paper/archive/**/*.docx
paper/main.log
paper/main.aux
paper/title.tex

# the leak scanner's project-specific patterns must never be published
scripts/private_patterns.txt
scripts/allowed_matches.txt

# os / editor
.DS_Store
.vscode/
.idea/
catboost_info/
