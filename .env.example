# Where the listings live (never committed). Two forms are accepted:
#   - a SQLite file path (zero-setup default)
#   - a PostgreSQL DSN for the production feed, e.g.
#     APPRAISENET_DB=postgresql://appraisenet:secret@localhost:5432/appraisenet
# The schema is documented in src/appraisenet/data.py; without a database, every
# command falls back to the synthetic corpus. In AWS the RDS DSN arrives as
# DATABASE_URL, which is honoured as a fallback name.
APPRAISENET_DB=data/listings.db
# MLflow tracking (defaults to sqlite:///reports/mlflow.db)
# MLFLOW_TRACKING_URI=
